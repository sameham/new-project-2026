rules_version = '2';

// صور التحويلات والنسخ الاحتياطية: لأعضاء مساحة العمل فقط
service firebase.storage {
  match /b/{bucket}/o {
    match /{wid}/{allPaths=**} {
      allow read, write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/workspaces/$(wid)/users/$(request.auth.uid));
    }
  }
}
