rules_version = '2';

// قواعد أمان Firestore:
// - كل مستخدم يقرأ ملفه التعريفي فقط (users/{uid})
// - بيانات مساحة العمل متاحة فقط لأعضائها النشطين
// - الكتابة في users داخل المساحة للمدير فقط (أو المستخدم يكتب سجله عند أول دخول)
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // ملف التعريف يُنشأ عند أول دخول، أو ينشئه المدير عند إضافة مستخدم
      allow write: if request.auth != null &&
        (request.auth.uid == uid || isWorkspaceAdmin(request.resource.data.workspaceId));
    }

    match /workspaces/{wid}/{collection}/{docId} {
      allow read, write: if isActiveMember(wid);
    }

    function isActiveMember(wid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/workspaces/$(wid)/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/workspaces/$(wid)/users/$(request.auth.uid)).data.isActive == true;
    }

    function isWorkspaceAdmin(wid) {
      return request.auth != null &&
        get(/databases/$(database)/documents/workspaces/$(wid)/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
  }
}
